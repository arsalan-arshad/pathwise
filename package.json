{
  "name": "pathwise",
  "version": "0.1.0",
  "description": "A query planner for RAG and agent pipelines: meet your quality SLA at the lowest cost.",
  "keywords": [
    "rag",
    "llm",
    "agents",
    "query-planner",
    "cost-optimization",
    "model-routing",
    "typescript"
  ],
  "author": {
    "name": "Arsalan Arshad",
    "email": "arsalanarshad.dev@gmail.com",
    "url": "https://arsalandev.studio"
  },
  "homepage": "https://github.com/arsalan-arshad/pathwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalan-arshad/pathwise.git"
  },
  "bugs": {
    "url": "https://github.com/arsalan-arshad/pathwise/issues"
  },
  "main": "dist/index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "demo": "tsx examples/demo.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck examples/demo.ts examples/sla-bench.ts",
    "bench:sla": "tsx examples/sla-bench.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
