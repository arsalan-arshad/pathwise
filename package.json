{
  "name": "@arsalandev/pathwise",
  "version": "0.1.0",
  "description": "A query planner for RAG and agent pipelines: meet your quality SLA at the lowest cost.",
  "keywords": [
    "rag",
    "llm",
    "agents",
    "query-planner",
    "cost-optimization",
    "model-routing",
    "typescript"
  ],
  "author": {
    "name": "Arsalan Arshad",
    "email": "arsalanarshad.dev@gmail.com",
    "url": "https://arsalandev.studio"
  },
  "homepage": "https://github.com/arsalan-arshad/pathwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalan-arshad/pathwise.git"
  },
  "bugs": {
    "url": "https://github.com/arsalan-arshad/pathwise/issues"
  },
  "main": "dist/index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "demo": "tsx examples/demo.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck examples/demo.ts examples/sla-bench.ts examples/prune-bench.ts examples/vercel-ai.ts examples/quickstart.ts examples/openai-compatible.ts examples/embeddings.ts examples/langchain.ts examples/fallback-bench.ts examples/recommend-check.ts examples/postgres.ts bench/real-servers/postgres.ts bench/real-servers/postgres-check.ts bench/real-rag/recommend-eval.ts bench/real-rag/run.ts bench/real-rag/pilot.ts bench/real-rag/replay.ts bench/real-rag/table.ts bench/real-rag/fill.ts bench/real-rag/fill-check.ts bench/real-rag/analyze.ts bench/real-rag/analyze-core.ts bench/real-rag/analyze-check.ts bench/real-rag/certify.ts bench/real-rag/certify-core.ts bench/real-rag/certify-check.ts bench/real-rag/probe.ts bench/real-rag/probe-core.ts bench/real-rag/probe-check.ts bench/real-rag/questions.ts bench/real-rag/musique.ts bench/real-rag/single-plan.ts bench/real-rag/single-plan-core.ts bench/real-rag/single-plan-check.ts bench/real-rag/embed-compare.ts bench/real-rag/embed-compare-check.ts bench/real-servers/ollama.ts bench/real-servers/ollama-check.ts",
    "bench:sla": "tsx examples/sla-bench.ts",
    "bench:prune": "tsx examples/prune-bench.ts",
    "bench:fallback": "tsx examples/fallback-bench.ts",
    "bench:rag:smoke": "tsx bench/real-rag/pilot.ts --smoke",
    "bench:rag:pilot": "tsx bench/real-rag/pilot.ts",
    "bench:rag": "tsx bench/real-rag/run.ts",
    "bench:rag:replay": "tsx bench/real-rag/replay.ts",
    "bench:rag:table": "tsx bench/real-rag/table.ts",
    "bench:rag:fill": "tsx bench/real-rag/fill.ts",
    "bench:rag:analyze": "tsx bench/real-rag/analyze.ts",
    "bench:rag:analyze:check": "tsx bench/real-rag/analyze-check.ts",
    "bench:rag:certify": "tsx bench/real-rag/certify.ts",
    "bench:rag:certify:check": "tsx bench/real-rag/certify-check.ts",
    "bench:rag:probe": "tsx bench/real-rag/probe.ts",
    "bench:rag:probe:check": "tsx bench/real-rag/probe-check.ts",
    "bench:rag:recommend": "tsx bench/real-rag/recommend-eval.ts",
    "bench:recommend": "tsx examples/recommend-check.ts",
    "bench:postgres": "tsx examples/postgres.ts",
    "smoke:postgres": "tsx bench/real-servers/postgres.ts",
    "smoke:postgres:check": "tsx bench/real-servers/postgres-check.ts",
    "bench:rag:single-plan": "tsx bench/real-rag/single-plan.ts",
    "bench:rag:single-plan:check": "tsx bench/real-rag/single-plan-check.ts",
    "bench:rag:embed-compare": "tsx bench/real-rag/embed-compare.ts",
    "bench:rag:embed-compare:check": "tsx bench/real-rag/embed-compare-check.ts",
    "bench:rag:fill:check": "tsx bench/real-rag/fill-check.ts",
    "smoke:ollama": "tsx bench/real-servers/ollama.ts",
    "smoke:ollama:check": "tsx bench/real-servers/ollama-check.ts",
    "bench:adapter": "tsx examples/vercel-ai.ts",
    "bench:embeddings": "tsx examples/embeddings.ts",
    "bench:langchain": "tsx examples/langchain.ts",
    "bench:openai-compatible": "tsx examples/openai-compatible.ts",
    "example:quickstart": "tsx examples/quickstart.ts",
    "smoke:real-packages": "bash bench/real-packages/run.sh",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./embeddings": {
      "types": "./dist/adapters/embeddings.d.ts",
      "default": "./dist/adapters/embeddings.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "default": "./dist/adapters/langchain.js"
    },
    "./openai-compatible": {
      "types": "./dist/adapters/openai-compatible.d.ts",
      "default": "./dist/adapters/openai-compatible.js"
    },
    "./postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
