{
  "name": "pathwise",
  "version": "0.1.0",
  "description": "A query planner for RAG and agent pipelines: meet your quality SLA at the lowest cost.",
  "keywords": [
    "rag",
    "llm",
    "agents",
    "query-planner",
    "cost-optimization",
    "model-routing",
    "typescript"
  ],
  "author": {
    "name": "Arsalan Arshad",
    "email": "arsalanarshad.dev@gmail.com",
    "url": "https://arsalandev.studio"
  },
  "homepage": "https://github.com/arsalan-arshad/pathwise#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalan-arshad/pathwise.git"
  },
  "bugs": {
    "url": "https://github.com/arsalan-arshad/pathwise/issues"
  },
  "main": "dist/index.js",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "demo": "tsx examples/demo.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck examples/demo.ts examples/sla-bench.ts examples/prune-bench.ts examples/vercel-ai.ts examples/embeddings.ts examples/langchain.ts examples/fallback-bench.ts bench/real-rag/run.ts bench/real-rag/pilot.ts bench/real-rag/replay.ts bench/real-rag/table.ts",
    "bench:sla": "tsx examples/sla-bench.ts",
    "bench:prune": "tsx examples/prune-bench.ts",
    "bench:fallback": "tsx examples/fallback-bench.ts",
    "bench:rag:smoke": "tsx bench/real-rag/pilot.ts --smoke",
    "bench:rag:pilot": "tsx bench/real-rag/pilot.ts",
    "bench:rag": "tsx bench/real-rag/run.ts",
    "bench:rag:replay": "tsx bench/real-rag/replay.ts",
    "bench:rag:table": "tsx bench/real-rag/table.ts",
    "bench:adapter": "tsx examples/vercel-ai.ts",
    "bench:embeddings": "tsx examples/embeddings.ts",
    "bench:langchain": "tsx examples/langchain.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "default": "./dist/adapters/vercel-ai.js"
    },
    "./embeddings": {
      "types": "./dist/adapters/embeddings.d.ts",
      "default": "./dist/adapters/embeddings.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "default": "./dist/adapters/langchain.js"
    }
  }
}
